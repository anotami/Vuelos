# SerpApi (flight searches)
SERPAPI_KEY=xxx

# Supabase – used server-side (service role key, never exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_KEY=xxx

# GitHub – needed by the web API to trigger workflow_dispatch
GH_REPO=owner/repo
GH_PAT=ghp_xxx
